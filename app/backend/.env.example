# Central application database (the setup script starts this on localhost:5433).
DATABASE=postgresql+asyncpg://devolib:devolib@localhost:5433/devolib

# Authentication. setup.ps1 generates safe local values for both keys.
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240
ENCRYPTION_KEY=replace-with-a-fernet-key

# Local application URLs.
DEV_SERVER=http://localhost:3000
DEV_SERVER_BACKEND=http://localhost:8000
FRONT-END-PROD=http://localhost:3000

# Optional integrations. Their features remain unavailable until configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
DEEPSEEK_API_KEY=
STRIPE_SECRET_KEY=

# Cloudflare R2 template storage. These are read while the backend imports, so
# local placeholders are used by setup.ps1; real values are needed to scaffold
# the R2-hosted React, FastAPI, and logging templates.
CF_ACCOUNT_ID=local-development
R2_ACCESS_KEY=local-development
R2_SECRET_KEY=local-development
R2_BUCKET_NAME=devolib-templates
